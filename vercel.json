{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "PORT=3000 BASE_PATH=/ pnpm --filter @workspace/wealthhub-site run build",
  "outputDirectory": "artifacts/wealthhub-site/dist/public",
  "rewrites": [
    {
      "source": "/wealthhub",
      "destination": "/wealthhub/index.html"
    },
    {
      "source": "/((?!assets/|wealthhub/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
